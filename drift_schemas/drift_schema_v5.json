  "fixed_sql": [
    {
      "name": "food_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"food_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"day\" TEXT NOT NULL, \"meal_type\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"brand\" TEXT NULL, \"quantity_grams\" REAL NOT NULL, \"kcal_per100g\" REAL NULL, \"protein_per100g\" REAL NULL, \"carbs_per100g\" REAL NULL, \"fat_per100g\" REAL NULL, \"source\" TEXT NOT NULL DEFAULT 'manual', \"portion_unit\" TEXT NULL, \"portion_count\" REAL NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "cached_products",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_products\" (\"barcode\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"brand\" TEXT NULL, \"quantity\" TEXT NULL, \"kcal_per100g\" REAL NULL, \"protein_per100g\" REAL NULL, \"carbs_per100g\" REAL NULL, \"fat_per100g\" REAL NULL, \"nutri_score\" TEXT NULL, \"serving_size\" TEXT NULL, \"serving_grams\" REAL NULL, \"package_grams\" REAL NULL, \"liquid\" INTEGER NOT NULL DEFAULT 0 CHECK (\"liquid\" IN (0, 1)), \"last_fetched_at\" INTEGER NOT NULL, PRIMARY KEY (\"barcode\"));"
        }
      ]
    },
    {
      "name": "workout_plans",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workout_plans\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"goal\" TEXT NOT NULL, \"active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"active\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "workout_days",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workout_days\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"plan_id\" INTEGER NOT NULL, \"day_number\" INTEGER NOT NULL, \"name_pt\" TEXT NOT NULL, \"name_en\" TEXT NOT NULL, \"weekday\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "exercise_catalog",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercise_catalog\" (\"exercise_key\" TEXT NOT NULL, \"name_pt\" TEXT NOT NULL, \"name_en\" TEXT NOT NULL, \"muscle_group\" TEXT NOT NULL, \"instructions_pt\" TEXT NOT NULL, \"instructions_en\" TEXT NOT NULL, \"equipment\" TEXT NOT NULL, \"difficulty\" TEXT NOT NULL, PRIMARY KEY (\"exercise_key\"));"
        }
      ]
    },
    {
      "name": "plan_exercises",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"plan_exercises\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"day_id\" INTEGER NOT NULL, \"exercise_key\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, \"sets\" INTEGER NOT NULL DEFAULT 3, \"rep_target\" INTEGER NOT NULL DEFAULT 10, \"rest_seconds\" INTEGER NOT NULL DEFAULT 90);"
        }
      ]
    },
    {
      "name": "workout_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workout_sessions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"day\" TEXT NOT NULL, \"plan_name\" TEXT NOT NULL, \"workout_name\" TEXT NOT NULL, \"started_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"finished_at\" INTEGER NULL, \"status\" TEXT NOT NULL DEFAULT 'active');"
        }
      ]
    },
    {
      "name": "exercise_sets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercise_sets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_id\" INTEGER NOT NULL, \"exercise_key\" TEXT NOT NULL, \"set_number\" INTEGER NOT NULL, \"target_reps\" INTEGER NOT NULL, \"reps\" INTEGER NULL, \"weight_kg\" REAL NULL, \"completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"completed\" IN (0, 1)), \"completed_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "body_measurements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"body_measurements\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"measured_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"weight_kg\" REAL NOT NULL, \"note\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "schedule_skips",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"schedule_skips\" (\"date\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"date\"));"
        }
      ]
    },
    {
      "name": "motion_analyses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"motion_analyses\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"exercise_key\" TEXT NOT NULL, \"pattern_id\" TEXT NOT NULL, \"started_at\" INTEGER NOT NULL, \"duration_ms\" INTEGER NOT NULL, \"full_reps\" INTEGER NOT NULL, \"partial_reps\" INTEGER NOT NULL, \"hold_ms\" INTEGER NOT NULL DEFAULT 0, \"mean_confidence\" REAL NOT NULL, \"observed_ratio\" REAL NOT NULL, \"status\" TEXT NOT NULL, \"events_json\" TEXT NOT NULL DEFAULT '[]', \"technique_score\" REAL NULL);"
        }
      ]
    }
  ]
